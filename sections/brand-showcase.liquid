{%- assign animate = settings.animations_reveal_on_scroll -%}

<div class="brand-showcase color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="brand-showcase__head{% if animate %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.heading != blank -%}
        <h2 class="brand-showcase__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="brand-showcase__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <ul class="brand-showcase__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign brand_label = block.settings.title | default: block.settings.collection.title
          assign monogram = block.settings.monogram
          if monogram == blank
            assign monogram = brand_label | slice: 0 | upcase
          endif
        -%}
        <li
          class="brand-showcase__item{% if animate %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if animate %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <a
            class="brand-card has-motion-arrow color-{{ block.settings.color_scheme }}"
            {% if block.settings.collection != blank %}
              href="{{ block.settings.collection.url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <span class="brand-card__fill" aria-hidden="true"></span>
            <span class="brand-card__monogram" aria-hidden="true">{{ monogram | escape }}</span>
            <span class="brand-card__body">
              <span class="brand-card__title">{{ brand_label | escape }}</span>
              {%- if block.settings.description != blank -%}
                <span class="brand-card__description">{{ block.settings.description | escape }}</span>
              {%- endif -%}
            </span>
            <span class="brand-card__cta">
              {{- 'sections.brand-showcase.cta' | t -}}
              {%- render 'motion-arrow' -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .brand-showcase__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2.4rem;
    flex-wrap: wrap;
    margin-bottom: 3.6rem;
  }

  .brand-showcase__heading {
    margin: 0;
  }

  .brand-showcase__subheading {
    margin: 0;
    max-width: 38ch;
    color: rgba(var(--color-foreground), 0.75);
  }

  .brand-showcase__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .brand-showcase__item {
    display: flex;
  }

  /* Card: the brand swatch (fill) grows from the top-left corner to cover the card */
  .brand-card {
    --swatch-size: 1.4rem;
    --swatch-center: calc(2.8rem + var(--swatch-size));

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 36rem;
    padding: 2.8rem;
    overflow: hidden;
    border-radius: var(--text-boxes-radius);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .brand-card__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--color-button));
    clip-path: circle(var(--swatch-size) at var(--swatch-center) var(--swatch-center));
    transition: clip-path var(--duration-slow) var(--ease-out-expo);
  }

  .brand-card__monogram {
    position: absolute;
    right: 1.6rem;
    bottom: -0.22em;
    z-index: -1;
    font-family: var(--font-heading-family);
    font-size: 24rem;
    line-height: 1;
    color: rgba(var(--color-button), 0.12);
    transition: transform var(--duration-slow) var(--ease-out-expo), color var(--duration-base) ease;
  }

  .brand-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: auto;
  }

  .brand-card__title {
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    line-height: 1.15;
  }

  .brand-card__description {
    max-width: 28ch;
    font-size: 1.4rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.78);
  }

  .brand-card__cta {
    display: inline-flex;
    align-items: center;
    margin-top: 2.4rem;
    color: rgb(var(--color-foreground));
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.06rem;
    text-transform: uppercase;
  }

  .brand-card__title,
  .brand-card__description,
  .brand-card__cta {
    transition: color var(--duration-base) ease;
  }

  .brand-card:focus-visible {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.3rem;
  }

  .brand-card:focus-visible .brand-card__fill {
    clip-path: circle(150% at var(--swatch-center) var(--swatch-center));
  }

  .brand-card:focus-visible .brand-card__title,
  .brand-card:focus-visible .brand-card__cta {
    color: rgb(var(--color-button-text));
  }

  .brand-card:focus-visible .brand-card__description {
    color: rgba(var(--color-button-text), 0.85);
  }

  .brand-card:focus-visible .brand-card__monogram {
    color: rgba(var(--color-button-text), 0.16);
  }

  @media (hover: hover) {
    .brand-card:hover .brand-card__fill {
      clip-path: circle(150% at var(--swatch-center) var(--swatch-center));
    }

    .brand-card:hover .brand-card__title,
    .brand-card:hover .brand-card__cta {
      color: rgb(var(--color-button-text));
    }

    .brand-card:hover .brand-card__description {
      color: rgba(var(--color-button-text), 0.85);
    }

    .brand-card:hover .brand-card__monogram {
      color: rgba(var(--color-button-text), 0.16);
      transform: translate(-1.2rem, -1.2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-card__fill,
    .brand-card__monogram {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .brand-showcase__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      gap: 1.2rem;
      margin: 0 -1.5rem;
      padding: 0 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.5rem;
      scrollbar-width: none;
    }

    .brand-showcase__grid::-webkit-scrollbar {
      display: none;
    }

    .brand-showcase__item {
      scroll-snap-align: start;
    }

    .brand-card {
      min-height: 30rem;
      padding: 2.4rem;
      --swatch-center: calc(2.4rem + var(--swatch-size));
    }

    .brand-card__monogram {
      font-size: 20rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.brand-showcase.name",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.brand-showcase.settings.heading.label",
      "default": "t:sections.brand-showcase.settings.heading.default"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.brand-showcase.settings.subheading.label",
      "default": "t:sections.brand-showcase.settings.subheading.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.brand-showcase.blocks.brand.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.brand-showcase.blocks.brand.settings.collection.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.brand-showcase.blocks.brand.settings.title.label",
          "info": "t:sections.brand-showcase.blocks.brand.settings.title.info"
        },
        {
          "type": "text",
          "id": "monogram",
          "label": "t:sections.brand-showcase.blocks.brand.settings.monogram.label",
          "info": "t:sections.brand-showcase.blocks.brand.settings.monogram.info"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:sections.brand-showcase.blocks.brand.settings.description.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.brand-showcase.presets.name",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}

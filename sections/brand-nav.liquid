<brand-nav-component class="brand-nav color-{{ section.settings.color_scheme }} gradient">
  <ul class="brand-nav__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign is_active = false
        if collection != blank and block.settings.collection != blank and collection.handle == block.settings.collection.handle
          assign is_active = true
        endif
        if product != blank and block.settings.collection != blank and product.collections contains block.settings.collection
          assign is_active = true
        endif
        assign brand_label = block.settings.title | default: block.settings.collection.title
      -%}
      <li class="brand-nav__item" {{ block.shopify_attributes }}>
        <a
          class="brand-nav__link color-{{ block.settings.color_scheme }}{% if is_active %} brand-nav__link--active{% endif %}"
          {% if block.settings.collection != blank %}
            href="{{ block.settings.collection.url }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 80 | image_tag: loading: 'lazy', width: 32, height: 32, class: 'brand-nav__logo' }}
          {%- endif -%}
          <span class="brand-nav__label">{{ brand_label }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</brand-nav-component>

{% stylesheet %}
  .brand-nav {
    height: 100%;
  }

  .brand-nav__list {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding: 1.2rem 1.5rem;
    margin: 0;
    list-style: none;
  }

  .brand-nav__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .brand-nav__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.4rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--buttons-radius);
    text-decoration: none;
    white-space: nowrap;
    transition: box-shadow 0.2s ease;
  }

  .brand-nav__link--active {
    box-shadow: 0 0 0 2px rgb(var(--color-button));
  }

  .brand-nav__logo {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    border-radius: 50%;
  }

  .brand-nav__label {
    font-size: 1.3rem;
    letter-spacing: 0.04rem;
  }

  @media screen and (min-width: 990px) {
    .brand-nav {
      position: sticky;
      top: 2rem;
    }

    .brand-nav__list {
      flex-direction: column;
      overflow-x: visible;
      padding: 2rem 1.5rem;
    }

    .brand-nav__item {
      scroll-snap-align: none;
    }

    .brand-nav__link {
      white-space: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.brand-nav.name",
  "class": "section",
  "enabled_on": {
    "groups": ["custom.brand_nav"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.brand-nav.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.brand-nav.blocks.brand.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.brand-nav.blocks.brand.settings.collection.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.brand-nav.blocks.brand.settings.title.label",
          "info": "t:sections.brand-nav.blocks.brand.settings.title.info"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.brand-nav.blocks.brand.settings.logo.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        }
      ]
    }
  ]
}
{% endschema %}

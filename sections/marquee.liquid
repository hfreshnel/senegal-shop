{%- comment -%}
  Each group repeats the items so a single group is always wider than the viewport,
  then the whole group is duplicated: the track translates by -50% for a seamless loop.
  Only the very first copy is exposed to assistive tech and to the theme editor.
{%- endcomment -%}
<marquee-band
  class="marquee color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.direction == 'right' %} marquee--reverse{% endif %}"
  style="--marquee-duration: {{ section.settings.speed }}s;"
>
  {%- if section.blocks.size > 0 -%}
    <div class="marquee__viewport">
      <div class="marquee__track">
        {%- for group in (1..2) -%}
          <ul
            class="marquee__group"
            role="list"
            {% if group > 1 %}
              aria-hidden="true"
            {% endif %}
          >
            {%- for repeat in (1..3) -%}
              {%- for block in section.blocks -%}
                <li
                  class="marquee__item"
                  {% if group == 1 and repeat == 1 %}
                    {{ block.shopify_attributes }}
                  {% else %}
                    aria-hidden="true"
                  {% endif %}
                >
                  {%- if block.settings.icon != 'none' -%}
                    <span class="marquee__icon" aria-hidden="true">
                      {%- case block.settings.icon -%}
                        {%- when 'lock' -%}
                          {{- 'icon-lock.svg' | inline_asset_content -}}
                        {%- when 'truck' -%}
                          {{- 'icon-truck.svg' | inline_asset_content -}}
                        {%- when 'price_tag' -%}
                          {{- 'icon-price-tag.svg' | inline_asset_content -}}
                        {%- when 'chat_bubble' -%}
                          {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
                        {%- when 'check_mark' -%}
                          {{- 'icon-check-mark.svg' | inline_asset_content -}}
                        {%- when 'plane' -%}
                          {{- 'icon-plane.svg' | inline_asset_content -}}
                        {%- when 'map_pin' -%}
                          {{- 'icon-map-pin.svg' | inline_asset_content -}}
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>

    <button
      type="button"
      class="marquee__toggle"
      aria-pressed="false"
      aria-label="{{ 'sections.marquee.pause' | t }}"
    >
      <span class="marquee__toggle-icon marquee__toggle-icon--pause" aria-hidden="true">
        {{- 'icon-pause.svg' | inline_asset_content -}}
      </span>
      <span class="marquee__toggle-icon marquee__toggle-icon--play" aria-hidden="true">
        {{- 'icon-play.svg' | inline_asset_content -}}
      </span>
    </button>
  {%- endif -%}
</marquee-band>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .marquee {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0 2.4rem;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    white-space: nowrap;
    color: rgb(var(--color-foreground));
  }

  .marquee__item::after {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    margin-left: 3.6rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .marquee__icon {
    display: flex;
    width: 2rem;
    height: 2rem;
  }

  .marquee__icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .marquee__toggle {
    position: absolute;
    top: 50%;
    right: 1.2rem;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    padding: 0;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 50%;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
  }

  .marquee:hover .marquee__toggle,
  .marquee__toggle:focus-visible,
  .marquee__toggle[aria-pressed='true'] {
    opacity: 1;
  }

  .marquee__toggle-icon {
    display: flex;
    width: 1rem;
    height: 1.2rem;
  }

  .marquee__toggle-icon svg {
    width: 100%;
    height: 100%;
  }

  .marquee__toggle-icon--play,
  .marquee__toggle[aria-pressed='true'] .marquee__toggle-icon--pause {
    display: none;
  }

  .marquee__toggle[aria-pressed='true'] .marquee__toggle-icon--play {
    display: flex;
  }

  @media (hover: none) {
    .marquee__toggle {
      opacity: 1;
    }

    /* Fade the text out before it reaches the always-visible toggle */
    .marquee__viewport {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 2.4rem, #000 calc(100% - 7.2rem), transparent calc(100% - 4.4rem));
      mask-image: linear-gradient(to right, transparent, #000 2.4rem, #000 calc(100% - 7.2rem), transparent calc(100% - 4.4rem));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marqueeScroll var(--marquee-duration) linear infinite;
    }

    .marquee--reverse .marquee__track {
      animation-direction: reverse;
    }

    .marquee__viewport:hover .marquee__track,
    .marquee--paused .marquee__track {
      animation-play-state: paused;
    }

    @keyframes marqueeScroll {
      to {
        transform: translateX(-50%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__toggle {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .marquee__item {
      font-size: 1.8rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('marquee-band')) {
    customElements.define(
      'marquee-band',
      class MarqueeBand extends HTMLElement {
        connectedCallback() {
          this.toggle = this.querySelector('.marquee__toggle');
          if (!this.toggle) return;
          this.toggle.addEventListener('click', () => this.setPaused(this.toggle.getAttribute('aria-pressed') !== 'true'));
        }

        setPaused(paused) {
          this.classList.toggle('marquee--paused', paused);
          this.toggle.setAttribute('aria-pressed', String(paused));
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.marquee.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "t:sections.marquee.settings.speed.label",
      "info": "t:sections.marquee.settings.speed.info",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.marquee.settings.direction.label",
      "options": [
        { "value": "left", "label": "t:sections.marquee.settings.direction.options__1.label" },
        { "value": "right", "label": "t:sections.marquee.settings.direction.options__2.label" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.marquee.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.marquee.blocks.item.settings.text.label",
          "default": "t:sections.marquee.blocks.item.settings.text.default"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.marquee.blocks.item.settings.icon.label",
          "options": [
            { "value": "none", "label": "t:sections.marquee.blocks.item.settings.icon.options__1.label" },
            { "value": "lock", "label": "t:sections.marquee.blocks.item.settings.icon.options__2.label" },
            { "value": "truck", "label": "t:sections.marquee.blocks.item.settings.icon.options__3.label" },
            { "value": "price_tag", "label": "t:sections.marquee.blocks.item.settings.icon.options__4.label" },
            { "value": "chat_bubble", "label": "t:sections.marquee.blocks.item.settings.icon.options__5.label" },
            { "value": "check_mark", "label": "t:sections.marquee.blocks.item.settings.icon.options__6.label" },
            { "value": "plane", "label": "t:sections.marquee.blocks.item.settings.icon.options__7.label" },
            { "value": "map_pin", "label": "t:sections.marquee.blocks.item.settings.icon.options__8.label" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.presets.name",
      "blocks": [
        { "type": "item", "settings": { "icon": "lock" } },
        { "type": "item", "settings": { "icon": "truck" } },
        { "type": "item", "settings": { "icon": "price_tag" } }
      ]
    }
  ]
}
{% endschema %}

{%- liquid
  assign animate = settings.animations_reveal_on_scroll
  assign heading = section.settings.heading
  assign words = heading | split: ' '
  assign split_heading = false
  if animate and heading != blank
    unless heading contains '<'
      assign split_heading = true
    endunless
  endif
  assign word_count = 1
  if split_heading
    assign word_count = words.size
  endif
  assign route_path = 'M40 190 Q200 -100 360 190'
-%}

<div
  class="hero-route{% if animate %} hero-route--animate{% endif %} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  style="--hero-words: {{ word_count }};"
>
  <div class="page-width hero-route__grid">
    <div class="hero-route__content">
      {%- if heading != blank -%}
        {%- if split_heading -%}
          <h1 class="hero-route__heading" aria-label="{{ heading | strip_html | escape_once }}">
            {%- for word in words -%}
              <span class="hero-route__word" aria-hidden="true">
                <span class="hero-route__word-inner" style="--i: {{ forloop.index0 }};">{{ word }}</span>
              </span>
              {%- unless forloop.last -%}{{ ' ' }}{%- endunless -%}
            {%- endfor -%}
          </h1>
        {%- else -%}
          <h1 class="hero-route__heading">{{ heading }}</h1>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero-route__text hero-route__reveal rte" style="--d: 1;">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="hero-route__buttons hero-route__reveal" style="--d: 2;">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_1 }}"
              {% endif %}
              class="button has-motion-arrow{% if section.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{- section.settings.button_label_1 | escape -}}
              {%- render 'motion-arrow' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_2 }}"
              {% endif %}
              class="button{% if section.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.origin_label != blank or section.settings.destination_label != blank -%}
      <div class="hero-route__route">
        {%- if section.settings.route_caption != blank -%}
          <p class="hero-route__caption">{{ section.settings.route_caption | escape }}</p>
        {%- endif -%}

        <svg
          class="hero-route__svg"
          viewBox="0 0 400 230"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <mask id="HeroRouteMask-{{ section.id }}" maskUnits="userSpaceOnUse" x="0" y="-20" width="400" height="260">
              <path
                class="hero-route__mask-path"
                d="{{ route_path }}"
                stroke="#fff"
                stroke-width="8"
                fill="none"
                pathLength="1"
              />
            </mask>
          </defs>

          <g mask="url(#HeroRouteMask-{{ section.id }})">
            <path
              class="hero-route__path"
              d="{{ route_path }}"
              stroke-width="2"
              stroke-linecap="round"
              stroke-dasharray="2 9"
            />
          </g>

          <circle class="hero-route__point" cx="40" cy="190" r="6" />
          <circle class="hero-route__pulse" cx="360" cy="190" r="6" />
          <circle class="hero-route__point hero-route__point--end" cx="360" cy="190" r="6" />

          {%- if animate -%}
            <g class="hero-route__parcel" opacity="0">
              <animateMotion
                path="{{ route_path }}"
                dur="6s"
                begin="1.6s"
                repeatCount="indefinite"
                calcMode="spline"
                keyTimes="0;1"
                keyPoints="0;1"
                keySplines="0.45 0 0.2 1"
              />
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                keyTimes="0;0.08;0.88;1"
                dur="6s"
                begin="1.6s"
                repeatCount="indefinite"
              />
              <rect x="-10" y="-9" width="20" height="18" rx="2.5" />
              <path d="M0 -9V9M-10 -2.5H10" />
            </g>
          {%- endif -%}
        </svg>

        <div class="hero-route__labels">
          <span class="hero-route__label hero-route__label--start">{{ section.settings.origin_label | escape }}</span>
          <span class="hero-route__label hero-route__label--end">{{ section.settings.destination_label | escape }}</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .hero-route {
    position: relative;
    overflow: hidden;
  }

  .hero-route__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 4rem;
    align-items: center;
  }

  .hero-route__heading {
    max-width: 14ch;
    margin: 0 0 2.4rem;
    font-size: clamp(4rem, 2.4rem + 3.6vw, 7.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero-route__word {
    display: inline-block;
    overflow: clip;
    vertical-align: bottom;
    padding-block: 0.12em 0.16em;
    margin-block: -0.12em -0.16em;
  }

  .hero-route__word-inner {
    display: inline-block;
  }

  .hero-route__text {
    max-width: 42ch;
    margin: 0 0 3.2rem;
    font-size: 1.7rem;
    color: rgba(var(--color-foreground), 0.82);
  }

  .hero-route__buttons {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  /* Route visual */
  .hero-route__route {
    position: relative;
    padding: 3.2rem 0 0;
  }

  .hero-route__route::before {
    content: '';
    position: absolute;
    inset: -20% -15%;
    background-image: radial-gradient(rgba(var(--color-foreground), 0.16) 1px, transparent 1.6px);
    background-size: 1.6rem 1.6rem;
    -webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent);
    mask-image: radial-gradient(closest-side, #000 20%, transparent);
    pointer-events: none;
  }

  .hero-route__caption {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.5rem 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 4rem;
    font-size: 1.2rem;
    letter-spacing: 0.06rem;
    white-space: nowrap;
    background: rgb(var(--color-background));
  }

  .hero-route__svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero-route__path {
    stroke: rgba(var(--color-foreground), 0.7);
  }

  .hero-route__point {
    fill: rgb(var(--color-button));
  }

  .hero-route__point--end,
  .hero-route__pulse {
    fill: rgb(var(--color-foreground));
  }

  .hero-route__pulse {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero-route__parcel rect {
    fill: rgb(var(--color-button));
  }

  .hero-route__parcel path {
    stroke: rgb(var(--color-button-text));
    stroke-width: 1.5;
    stroke-opacity: 0.7;
  }

  .hero-route__labels {
    position: relative;
    height: 2rem;
    margin-top: 1.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.75);
  }

  .hero-route__label {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .hero-route__label--start {
    left: 10%;
  }

  .hero-route__label--end {
    left: 90%;
  }

  /* Motion */
  @media (prefers-reduced-motion: no-preference) {
    .hero-route--animate .hero-route__word-inner {
      animation: heroWordUp var(--duration-slow) var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 70ms);
    }

    .hero-route--animate .hero-route__reveal {
      animation: heroFadeUp var(--duration-slow) var(--ease-out-expo) both;
      animation-delay: calc(var(--hero-words) * 70ms + var(--d) * 120ms);
    }

    .hero-route--animate .hero-route__mask-path {
      stroke-dasharray: 1;
      animation: heroRouteDraw 1.4s var(--ease-out-expo) 0.3s both;
    }

    .hero-route--animate .hero-route__path {
      animation: heroRouteFlow 1.6s linear infinite;
    }

    .hero-route--animate .hero-route__point--end,
    .hero-route--animate .hero-route__label--end {
      animation: heroFadeIn var(--duration-base) ease 1.4s both;
    }

    .hero-route--animate .hero-route__caption {
      animation: heroFadeIn var(--duration-base) ease 1s both;
    }

    .hero-route--animate .hero-route__pulse {
      animation: heroRoutePulse 2.4s var(--ease-out-expo) 1.6s infinite;
    }

    @keyframes heroWordUp {
      from {
        transform: translateY(110%);
      }
      to {
        transform: translateY(0);
      }
    }

    @keyframes heroFadeUp {
      from {
        opacity: 0;
        transform: translateY(1.6rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes heroFadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes heroRouteDraw {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes heroRouteFlow {
      to {
        stroke-dashoffset: -11;
      }
    }

    @keyframes heroRoutePulse {
      0% {
        opacity: 0.5;
        transform: scale(1);
      }
      70%,
      100% {
        opacity: 0;
        transform: scale(3.2);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-route__parcel {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .hero-route__grid {
      grid-template-columns: 1fr;
      gap: 3.2rem;
    }

    .hero-route__text {
      font-size: 1.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero-route.name",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.hero-route.settings.heading.label",
      "default": "t:sections.hero-route.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-route.settings.text.label",
      "default": "t:sections.hero-route.settings.text.default"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:sections.hero-route.settings.button_label_1.label",
      "default": "t:sections.hero-route.settings.button_label_1.default"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:sections.hero-route.settings.button_link_1.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_1",
      "label": "t:sections.hero-route.settings.button_style_secondary.label",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.hero-route.settings.button_label_2.label",
      "default": "t:sections.hero-route.settings.button_label_2.default"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.hero-route.settings.button_link_2.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_2",
      "label": "t:sections.hero-route.settings.button_style_secondary.label",
      "default": true
    },
    {
      "type": "text",
      "id": "origin_label",
      "label": "t:sections.hero-route.settings.origin_label.label",
      "default": "t:sections.hero-route.settings.origin_label.default"
    },
    {
      "type": "text",
      "id": "destination_label",
      "label": "t:sections.hero-route.settings.destination_label.label",
      "default": "t:sections.hero-route.settings.destination_label.default"
    },
    {
      "type": "text",
      "id": "route_caption",
      "label": "t:sections.hero-route.settings.route_caption.label",
      "info": "t:sections.hero-route.settings.route_caption.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 76
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-route.presets.name"
    }
  ]
}
{% endschema %}
